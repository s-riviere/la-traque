{
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "exclude": ["node_modules", ".next"],
}
